                "id": "10e92b40-93ed-44d4-b802-947bb82914c1",
                "name": "Merge"
            },
            {
                "parameters": {
                    "jsCode": "\nvar skillNames = [];\nvar jobs = [];\nvar applications = [];\nfor (const item of $input.all()) {\n  if(item.json.skills){\n    for(var group in item.json.skills){\n      for(var skill in item.json.skills[group]){\n        skillNames.push(item.json.skills[group][skill].skill);\n      }\n    }\n  }\n  else if(item.json.job){\n    jobs.push(item.json.job);\n  }\n  else if(item.json.application){\n    applications.push({\"content\":item.json.application});\n  }\n}\nskillNames = [...new Set(skillNames)];\n\n\n\nreturn [{\n  json:{\n    skills: skillNames,\n    jobs,\n    applications\n  }\n}]"
                },
