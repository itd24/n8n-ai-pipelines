            {
                "parameters": {
                    "jsCode": "\nvar achievements = [];\nvar jobs = [];\nvar applications = [];\nfor (const item of $input.all()) {\n  if(item.json.achievements){\n    achievements = achievements.concat(item.json.achievements)\n  }\n  else if(item.json.job){\n    jobs.push(item.json.job);\n  }\n  else if(item.json.application){\n    applications.push({\"content\":item.json.application});\n  }\n}\nachievements = [...new Set(achievements)];\n\n\n\nreturn [{\n  json:{\n    achievements,\n    jobs,\n    applications\n  }\n}]"
                },
