        "nodes": [
            {
                "parameters": {
                    "jsCode": "const result = {};\nlet currentCategory = \"\";\n\nfor (const item of $input.all()) {\n    const skill = item.json[\"Technical Skills\"];\n    const level = item.json[\"Level\"];\n\n    if (level == \"\") {\n        // If there's no level, this row defines a new category\n        currentCategory = skill;\n        if (!result[currentCategory]) {\n            result[currentCategory] = [];\n        }\n    } else {\n        // Otherwise, add the skill to the current category\n        if (!result[currentCategory]) {\n            result[currentCategory] = [];\n        }\n        result[currentCategory].push({ skill, level });\n    }\n}\n\nreturn [{ json: {skills:result }}];"
                },
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    200,
                    -320
                ],
                "id": "3b00a4d7-523e-4d2b-ad26-7e28bf74ce9a",
                "name": "Code"
            },
            {
                "parameters": {
                    "jsCode": "var numberOfSheets = 6;\nvar result = [];\nfor(var i = 1;i<=numberOfSheets;i++){\n  result.push({\"sheet\":`CS_${i}`});\n}\nreturn result;"
                },
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    -20,
                    -140
                ],
                "id": "5a4841ea-4ba6-45d3-9aa7-5d0e645cc0c4",
