                "name": "Loop Over Items",
                "alwaysOutputData": false
            },
            {
                "parameters": {
                    "jsCode": "var job = {\n  \"from\":\"\",\n  \"to\":\"\",\n  \"description\":\"\",\n  \"company\":\"\",\n  \"location\":\"\",\n  \"title\":\"\"\n}\n\nfor (const item of $input.all()) {\n  if(item.json.col_1 == \"From\"){\n    job.from = item.json.EN;\n    job.description = item.json.DESCRIPTION;\n  }\n  else if(item.json.col_1 == \"To\"){\n    job.to = item.json.EN;\n  }\n  else if(item.json.col_1 == \"Company\"){\n    job.company = item.json.EN;\n  }\n  else if(item.json.col_1 == \"Location\"){\n    job.location = item.json.EN;\n  }\n  else if(item.json.col_1 == \"Title\"){\n    job.title = item.json.EN;\n  }\n}\n\nreturn [{\"json\":{\n  job\n}}]"
                },
