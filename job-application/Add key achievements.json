            {
                "parameters": {
                    "jsCode": "\nvar key_achievements = [];\nvar jobs = [];\nvar applications = [];\nfor (const item of $input.all()) {\n  if(item.json.key_achievements){\n    key_achievements = key_achievements.concat(item.json.key_achievements)\n  }\n  else if(item.json.job){\n    jobs.push(item.json.job);\n  }\n  else if(item.json.application){\n    applications.push({\"content\":item.json.application});\n  }\n}\nkey_achievements = [...new Set(key_achievements)];\n\n\n\nreturn [{\n  json:{\n    key_achievements,\n    jobs,\n    applications\n  }\n}]"
                },
