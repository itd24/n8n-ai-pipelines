            {
                "parameters": {
                    "jsCode": "const blocks = $json.results || $input.all().map(i => i.json);\n\nfunction escape(content) {\n  return (content || '').toString();\n}\n\nfunction parseBlock(block) {\n  const type = block.type;\n  const content = escape(block.content);\n\n  switch (type) {\n    case 'paragraph':\n      return content + '\\n';\n\n    case 'heading_1':\n      return `# ${content}\\n`;\n\n    case 'heading_2':\n      return `## ${content}\\n`;\n\n    case 'heading_3':\n      return `### ${content}\\n`;\n\n    case 'bulleted_list_item':\n      return `- ${content}\\n`;\n\n    case 'numbered_list_item':\n      return `1. ${content}\\n`;\n\n    case 'quote':\n      return `> ${content}\\n`;\n\n    case 'code':\n      return '```' + '\\n' + content + '\\n```\\n';\n\n    case 'divider':\n      return `---\\n`;\n\n    default:\n      return '';\n  }\n}\n\nlet output = '';\n\nfor (const block of blocks) {\n  output += parseBlock(block) + '\\n';\n}\n\nreturn [\n  {\n    json: {\n      markdown: output.trim()\n    }\n  }\n];"
                },
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
                    448,
                    -64
                ],
                "id": "d6892efc-5770-46cd-8ada-4fb4d212c66c",
                "name": "Code in JavaScript"
            },
            {
                "parameters": {
                    "jsCode": "var title = $input.all()[0].json.name;\nvar markdown = $input.all()[1].json.markdown;\n\nreturn [{json: {content: `#${title}\\n\\n${markdown}`}}];"
                },
