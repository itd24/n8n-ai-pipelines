                "name": "Call 'Read And Structure NLB Main'"
            },
            {
                "parameters": {
                    "jsCode": "let currentAmount = 235.2;\n\nlet result = {\n  difference: 0.0,\n  initialDate: '2099-01-01',\n  endDate: '1970-01-01'\n};\n\nlet allData = $input.all().flatMap(x => x.json.data);\n\nconst unique = [...new Map(allData.map(item => [item.id, item])).values()];\n\nfor(var i in unique){\n  let t = unique[i];\n  if(t.type == 'deposit')\n  console.log(\"parsed:\", parseFloat(t.amount),\"type\",t.type);\n  if(t.type == 'withdrawal'){\n    //console.log(\"subtract\")\n    result.difference -= parseFloat(t.amount);\n  }\n  else{\n    //console.log('add');\n    result.difference += parseFloat(t.amount);\n  }\n  if(result.initialDate > t.date)\n    result.initialDate = t.date;\n  if(result.endDate < t.date)\n    result.endDate = t.date;\n}\n\nresult.initialAmount = currentAmount - result.difference;\n\nreturn [{\n  json: result\n}];\n"
                },
                "type": "n8n-nodes-base.code",
                "typeVersion": 2,
                "position": [
